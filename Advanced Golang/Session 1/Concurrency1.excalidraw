    {
      "id": "CxZP0w699LLJ6fccIrnur",
      "type": "text",
      "x": 346.99993896484375,
      "y": 774,
      "width": 1265.1475830078125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": null,
      "seed": 1643344418,
      "version": 309,
      "versionNonce": 2111872958,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1738342244745,
      "link": null,
      "locked": false,
      "text": "These tasks are scheduled between these threads until they are done. ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "These tasks are scheduled between these threads until they are done. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qNbrBZkUjJSIY6PsDXDuH",
      "type": "text",
      "x": 310.3333435058594,
      "y": 869,
      "width": 1330.8477783203125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0J",
      "roundness": null,
      "seed": 458702434,
      "version": 296,
      "versionNonce": 682367010,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1738342428334,
      "link": null,
      "locked": false,
      "text": "note: we don't have parallelism in processors with one core and one thread. ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "note: we don't have parallelism in processors with one core and one thread. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UXM6jHDfhSu9XeO0n9_0x",
      "type": "text",
      "x": 547.1416984442158,
      "y": 978.638414697841,
      "width": 812.1450447198467,
      "height": 116.08469487132086,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0K",
      "roundness": null,
      "seed": 1780396898,
      "version": 1339,
      "versionNonce": 1679910782,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1738342501671,
      "link": null,
      "locked": false,
      "text": "parallelism must be non-preemptive so in the scenario\nof one core and one thread one task must be done\nto another task start to have parallelism. ",
      "fontSize": 30.95591863235223,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "parallelism must be non-preemptive so in the scenario of one core and one thread one task must be done to another task start to have parallelism. ",
      "autoResize": false,
      "lineHeight": 1.25
    },
