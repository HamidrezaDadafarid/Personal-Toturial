    {
      "id": "g_rCk8pKDzSzmnRv44g-6",
      "type": "text",
      "x": 518.0000305175781,
      "y": 428.33331298828125,
      "width": 950.6577758789062,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 2018832922,
      "version": 1122,
      "versionNonce": 1903247322,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1738852498357,
      "link": null,
      "locked": false,
      "text": "Every time we append an element, length will be incremented by one. if\nwe reach a situation that length is equal to capacity, another array\nwith with the capacity of two times of the first array will be made.\nthen the first array will be copied in that array and the length will be\nincremented by one. the previous array will be removed from memory\nby garbage collector. ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every time we append an element, length will be incremented by one. if we reach a situation that length is equal to capacity, another array with with the capacity of two times of the first array will be made. then the first array will be copied in that array and the length will be incremented by one. the previous array will be removed from memory by garbage collector. ",
      "autoResize": false,
      "lineHeight": 1.25
    }
